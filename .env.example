# نشریار — نمونه تنظیمات محیط (کپی کنید به .env و مقادیر را پر کنید)

# مسیر دیتابیس — در داکر خودکار با file:/app/data/nashryar.db جایگزین می‌شود
DATABASE_URL="file:./nashryar.db"

# کلید امضای نشست‌ها — حتماً مقدار تصادفی خودتان را بگذارید:
# openssl rand -base64 48        (لینوکس)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# آدرس عمومی نشریار — لینک تصاویر آپلودی با همین ساخته می‌شود
# مثال: https://hub.example.com
APP_URL="http://127.0.0.1:3100"

NODE_ENV="production"
